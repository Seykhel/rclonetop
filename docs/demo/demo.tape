Output docs/demo/demo.gif
Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 12
Set Theme "Builtin Dark"
Set Framerate 12
Set TypingSpeed 50ms
Hide
Type "export TERM=xterm-256color COLORTERM=truecolor; stty cols 120 rows 32; exec ./bin/rclonetop-demo"
Enter
Sleep 1s
Show
Sleep 3s
Type "p"
Sleep 10s
Type "p"
Sleep 3s
Hide
Type "q"
Sleep 500ms
